{
  "name": "kindle-reborn",
  "private": true,
  "version": "1.0.0",
  "description": "A monochrome calendar, weather, almanac and fortune dashboard for Kindle e-ink displays.",
  "license": "MIT",
  "repository": "github:keyu-0915/KindleReborn",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lunar-javascript": "^1.7.7",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0"
  }
}
